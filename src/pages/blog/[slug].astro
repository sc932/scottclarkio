---
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/ibm-plex-sans";
import { render } from "astro:content";
import SiteLayout from "../../components/SiteLayout.astro";
import TitleParts from "../../components/TitleParts.astro";
import { v2Theme } from "../../lib/site-theme";
import { siteUrl } from "../../lib/site-content";
import {
  getPublishedPosts,
  buildBlogPostingSchema,
  postOgImage,
  postPath,
  postUrl,
  pillarPath,
  formatDate,
  pillarLabel,
  type Post,
} from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { Content } = await render(post);
const pageSchema = buildBlogPostingSchema(post);

// "Read next" (estate grammar, Scott 2026-07-24): two related posts at the
// end of every post. With a small corpus this is a complete clique (listing
// order); revisit with a real relevance pick once there are 6+ posts.
const related = (await getPublishedPosts())
  .filter((p) => p.id !== post.id)
  .slice(0, 2);

// Visible trail + its JSON-LD twin (SiteLayout builds the BreadcrumbList
// from this so the two never drift). The H1 is the current node. The root
// crumb names the publication — "Writing", matching the nav label and the
// feed identity ("Writing by Scott Clark").
const breadcrumbTrail = [
  { name: "Writing", item: `${siteUrl}/blog` },
  ...(post.data.pillar
    ? [
        {
          name: pillarLabel(post.data.pillar),
          item: `${siteUrl}${pillarPath(post.data.pillar)}`,
        },
      ]
    : []),
  { name: post.data.title, item: postUrl(post) },
];
---

<SiteLayout
  {...v2Theme}
  pageTitle={`${post.data.title} — Scott Clark`}
  pageDescription={post.data.description}
  ogType="article"
  ogImage={postOgImage(post)}
  ogImageAlt={`${post.data.title} (Scott Clark)`}
  article={{
    published: post.data.date.toISOString(),
    modified: post.data.updated?.toISOString(),
    author:
      post.data.author === "Scott Clark"
        ? "https://scottclark.io"
        : post.data.author,
  }}
  pageSchema={pageSchema}
  breadcrumbTrail={breadcrumbTrail}
>
  <article class="post">
    <header class="post-head">
      {/* Breadcrumbs (estate ruling, Scott 2026-07-25): publication root /
          pillar / — the H1 below is the current node. The pillar crumb opens
          the listing with that pillar floated to the top (sort-only until
          the corpus earns a real filter). */}
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/blog">Writing</a>
        <span class="sep" aria-hidden="true">/</span>
        {
          post.data.pillar && (
            <>
              <a href={pillarPath(post.data.pillar)}>
                {pillarLabel(post.data.pillar)}
              </a>
              <span class="sep" aria-hidden="true">/</span>
            </>
          )
        }
      </nav>
      <h1><TitleParts title={post.data.title} /></h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>
          {formatDate(post.data.date)}
        </time>
        {
          post.data.updated && (
            <span class="updated">
              Updated{" "}
              <time datetime={post.data.updated.toISOString().slice(0, 10)}>
                {formatDate(post.data.updated)}
              </time>
            </span>
          )
        }
        {/* Pillar chip mirrors the breadcrumb's target (estate ruling,
            2026-07-25): the sort-first listing view. */}
        {post.data.pillar && (
          <a class="chip" href={pillarPath(post.data.pillar)}>
            {pillarLabel(post.data.pillar)}
          </a>
        )}
        {post.data.format !== "post" && (
          <span class="chip">{post.data.format}</span>
        )}
        {
          post.data.author === "Scott Clark" ? (
            <a class="byline" href="/" rel="author">
              {post.data.author}
            </a>
          ) : (
            <span class="byline">{post.data.author}</span>
          )
        }
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      related.length > 0 && (
        <section class="related">
          <h2 class="related-label">Read next</h2>
          <div class="related-grid">
            {related.map((r) => (
              <a class="rel-card" href={postPath(r)}>
                <h3><TitleParts title={r.data.title} /></h3>
                <p class="rel-meta">
                  <time datetime={r.data.date.toISOString().slice(0, 10)}>
                    {formatDate(r.data.date)}
                  </time>
                  {r.data.pillar && (
                    <span class="rel-chip">{pillarLabel(r.data.pillar)}</span>
                  )}
                </p>
                <p class="rel-desc">{r.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <footer class="post-end">
      <p>
        <a href="/blog">&larr; All writing</a> &middot;
        <a href={`/blog/${post.id}.md`}>Markdown version</a> &middot;
        <a href="/rss.xml">RSS</a>
      </p>
    </footer>
  </article>
</SiteLayout>

<style is:global>
  .post-head {
    margin-bottom: 44px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--rule);
  }
  .post-head .crumb {
    margin: 0 0 18px;
    font-size: 13.5px;
  }
  .post-head .crumb a {
    color: var(--soft);
    text-decoration: none;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    font-size: 12px;
    white-space: nowrap; /* narrow viewports break between crumbs only */
  }
  .post-head .crumb a:hover {
    color: var(--accent);
  }
  .post-head .crumb .sep {
    margin: 0 5px;
    color: var(--soft);
    font-size: 12px;
  }
  .post-head h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 42px;
    line-height: 1.1;
    letter-spacing: -0.012em;
    margin: 0 0 14px;
    max-width: 760px;
  }
  .post-head .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    color: var(--mute);
    font-size: 14.5px;
  }
  .post-head .updated {
    color: var(--soft);
  }
  .post-head .byline {
    color: var(--soft);
  }
  a.byline {
    text-decoration: none;
  }
  a.byline:hover {
    color: var(--accent);
  }
  .chip {
    font-family: var(--sans);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--soft);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 2px 10px;
  }
  /* Pillar chip doubles as a link to the sort-first listing view. */
  a.chip {
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  a.chip:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Long-form reading column. */
  .prose {
    max-width: 680px;
    font-size: 17.5px;
    line-height: 1.65;
  }
  .prose p {
    margin: 0 0 18px;
  }
  .prose h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.18;
    letter-spacing: -0.008em;
    margin: 46px 0 14px;
  }
  .prose h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 22px;
    margin: 36px 0 10px;
  }
  .prose h2 a,
  .prose h3 a {
    text-decoration: none;
    color: inherit;
  }
  .prose h2 a:hover,
  .prose h3 a:hover {
    color: var(--accent);
  }
  .prose ul,
  .prose ol {
    margin: 0 0 18px;
    padding-left: 26px;
  }
  .prose li {
    margin-bottom: 6px;
  }
  .prose blockquote {
    margin: 24px 0;
    padding: 2px 0 2px 18px;
    border-left: 2px solid var(--rule);
    color: var(--mute);
  }
  .prose blockquote p {
    margin-bottom: 10px;
  }
  .prose code {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.92em;
    background: #f2ece1;
    border-radius: 3px;
    padding: 1px 5px;
  }
  .prose pre {
    margin: 24px 0;
    padding: 16px 18px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow-x: auto;
    font-size: 14.5px;
    line-height: 1.55;
  }
  .prose pre code {
    background: none;
    padding: 0;
  }
  .prose hr {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 40px 0;
  }

  /* Plain markdown images (rasters the inline-SVG Figure lane can't carry)
     stay bounded to the column on the same plate language as Figure —
     hairline border, never a shadow; white mat. */
  .prose img {
    display: block;
    box-sizing: border-box;
    max-width: 100%;
    height: auto;
    margin: 24px 0;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 12px;
  }

  /* Figures: white plate + hairline border (never a shadow — rules are the
     estate's only depth vocabulary). */
  .post-figure {
    margin: 40px 0;
    max-width: 820px;
  }
  .post-figure .fig-panel {
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 24px;
  }
  .post-figure svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .post-figure figcaption {
    margin-top: 12px;
    color: var(--mute);
    font-size: 14px;
    line-height: 1.55;
    max-width: 680px;
  }

  /* Read next — related cards above the utility crumbs (estate grammar,
     Scott 2026-07-24). The card CSS family (.related*, .rel-*) lives in
     SiteLayout's global block since 2026-07-28 — shared with the home
     Writing cards; edit it there. */

  .post-end {
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: 14.5px;
    color: var(--mute);
  }
  .post-end a {
    color: var(--mute);
  }
  .post-end a:hover {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .post-head h1 {
      font-size: 32px;
    }
    .prose {
      font-size: 17px;
    }
  }
</style>
