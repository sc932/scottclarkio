---
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/ibm-plex-sans";
import { render } from "astro:content";
import SiteLayout from "../../components/SiteLayout.astro";
import { v2Theme } from "../../lib/site-theme";
import {
  getPublishedPosts,
  buildBlogPostingSchema,
  postOgImage,
  formatDate,
  pillarLabel,
  type Post,
} from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { Content } = await render(post);
const pageSchema = buildBlogPostingSchema(post);
---

<SiteLayout
  {...v2Theme}
  pageTitle={`${post.data.title} — Scott Clark`}
  pageDescription={post.data.description}
  ogType="article"
  ogImage={postOgImage(post)}
  ogImageAlt={`${post.data.title} (Scott Clark)`}
  article={{
    published: post.data.date.toISOString(),
    modified: post.data.updated?.toISOString(),
    author: post.data.author,
  }}
  pageSchema={pageSchema}
>
  <article class="post">
    <header class="post-head">
      <p class="crumb"><a href="/blog">Writing</a></p>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>
          {formatDate(post.data.date)}
        </time>
        {
          post.data.updated && (
            <span class="updated">
              Updated{" "}
              <time datetime={post.data.updated.toISOString().slice(0, 10)}>
                {formatDate(post.data.updated)}
              </time>
            </span>
          )
        }
        {post.data.pillar && (
          <span class="chip">{pillarLabel(post.data.pillar)}</span>
        )}
        {post.data.format !== "post" && (
          <span class="chip">{post.data.format}</span>
        )}
        {
          post.data.author === "Scott Clark" ? (
            <a class="byline" href="/" rel="author">
              {post.data.author}
            </a>
          ) : (
            <span class="byline">{post.data.author}</span>
          )
        }
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-end">
      <p>
        <a href="/blog">&larr; All writing</a> &middot;
        <a href={`/blog/${post.id}.md`}>Markdown version</a> &middot;
        <a href="/rss.xml">RSS</a>
      </p>
    </footer>
  </article>
</SiteLayout>

<style is:global>
  .post-head {
    margin-bottom: 44px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--rule);
  }
  .post-head .crumb {
    margin: 0 0 18px;
    font-size: 13.5px;
  }
  .post-head .crumb a {
    color: var(--soft);
    text-decoration: none;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    font-size: 12px;
  }
  .post-head .crumb a:hover {
    color: var(--accent);
  }
  .post-head h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 42px;
    line-height: 1.1;
    letter-spacing: -0.012em;
    margin: 0 0 14px;
    max-width: 760px;
  }
  .post-head .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    color: var(--mute);
    font-size: 14.5px;
  }
  .post-head .updated {
    color: var(--soft);
  }
  .post-head .byline {
    color: var(--soft);
  }
  a.byline {
    text-decoration: none;
  }
  a.byline:hover {
    color: var(--accent);
  }
  .chip {
    font-family: var(--sans);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--soft);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 2px 10px;
  }

  /* Long-form reading column. */
  .prose {
    max-width: 680px;
    font-size: 17.5px;
    line-height: 1.65;
  }
  .prose p {
    margin: 0 0 18px;
  }
  .prose h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.18;
    letter-spacing: -0.008em;
    margin: 46px 0 14px;
  }
  .prose h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 22px;
    margin: 36px 0 10px;
  }
  .prose h2 a,
  .prose h3 a {
    text-decoration: none;
    color: inherit;
  }
  .prose h2 a:hover,
  .prose h3 a:hover {
    color: var(--accent);
  }
  .prose ul,
  .prose ol {
    margin: 0 0 18px;
    padding-left: 26px;
  }
  .prose li {
    margin-bottom: 6px;
  }
  .prose blockquote {
    margin: 24px 0;
    padding: 2px 0 2px 18px;
    border-left: 2px solid var(--rule);
    color: var(--mute);
  }
  .prose blockquote p {
    margin-bottom: 10px;
  }
  .prose code {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.92em;
    background: #f2ece1;
    border-radius: 3px;
    padding: 1px 5px;
  }
  .prose pre {
    margin: 24px 0;
    padding: 16px 18px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow-x: auto;
    font-size: 14.5px;
    line-height: 1.55;
  }
  .prose pre code {
    background: none;
    padding: 0;
  }
  .prose hr {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 40px 0;
  }

  /* Figures: white plate + hairline border (never a shadow — rules are the
     estate's only depth vocabulary). */
  .post-figure {
    margin: 40px 0;
    max-width: 820px;
  }
  .post-figure .fig-panel {
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 24px;
  }
  .post-figure svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .post-figure figcaption {
    margin-top: 12px;
    color: var(--mute);
    font-size: 14px;
    line-height: 1.55;
    max-width: 680px;
  }

  .post-end {
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: 14.5px;
    color: var(--mute);
  }
  .post-end a {
    color: var(--mute);
  }
  .post-end a:hover {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .post-head h1 {
      font-size: 32px;
    }
    .prose {
      font-size: 17px;
    }
  }
</style>
