---
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/ibm-plex-sans";
import SiteLayout from "../../components/SiteLayout.astro";
import { v2Theme } from "../../lib/site-theme";
import { blogTitle, blogDescription } from "../../lib/site-content";
import {
  getPublishedPosts,
  postPath,
  formatDate,
  pillarLabel,
  buildBlogIndexSchema,
} from "../../lib/blog";

const posts = await getPublishedPosts();
const pageSchema = buildBlogIndexSchema(posts);
---

<SiteLayout
  {...v2Theme}
  pageTitle={`${blogTitle} — Scott Clark`}
  pageDescription={blogDescription}
  pageSchema={pageSchema}
>
  <header class="page-head">
    <h1>{blogTitle}</h1>
    <p class="sub">{blogDescription}</p>
  </header>

  <ol class="post-list">
    {
      posts.map((post) => (
        <li class:list={["post-item", { pinned: post.data.pinned }]}>
          <article>
            {post.data.pinned && <p class="start-here">Start here</p>}
            <h2>
              <a href={postPath(post)}>{post.data.title}</a>
            </h2>
            <p class="meta">
              <time datetime={post.data.date.toISOString().slice(0, 10)}>
                {formatDate(post.data.date)}
              </time>
              {post.data.pillar && (
                <span class="chip">{pillarLabel(post.data.pillar)}</span>
              )}
              {post.data.format !== "post" && (
                <span class="chip">{post.data.format}</span>
              )}
            </p>
            <p class="desc">{post.data.description}</p>
          </article>
        </li>
      ))
    }
  </ol>
</SiteLayout>

<style is:global>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-item {
    padding: 30px 0;
    border-bottom: 1px solid var(--ruleSoft);
  }
  .post-item:first-child {
    padding-top: 0;
  }
  .post-item:last-child {
    border-bottom: none;
  }
  .start-here {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 8px;
  }
  .post-item h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 27px;
    line-height: 1.2;
    letter-spacing: -0.008em;
    margin: 0 0 8px;
  }
  .post-item h2 a {
    text-decoration: none;
  }
  .post-item .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0 0 10px;
    color: var(--mute);
    font-size: 14px;
  }
  .chip {
    font-family: var(--sans);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--soft);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 2px 10px;
  }
  .post-item .desc {
    margin: 0;
    color: var(--ink);
    font-size: 16px;
    line-height: 1.6;
    max-width: 660px;
  }
</style>
