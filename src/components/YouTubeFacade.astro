---
// Click-to-load YouTube facade — the only client JS in the blog grammar, and
// it ships ONLY on pages that use it. On load: a static poster image + play
// button (zero third-party script). On click: swaps in the youtube-nocookie
// iframe with autoplay. Keeps LCP/INP clean per the facade pattern.
// Usage in MDX (single-line, self-closing — the .md twin rewrite depends on
// this exact shape): <YouTubeFacade id="..." title="..." />
interface Props {
  /** YouTube video id (the 11-char id, not a URL). */
  id: string;
  title: string;
  /** Poster quality; maxresdefault falls back to hqdefault if missing. */
  poster?: "maxresdefault" | "hqdefault";
}
const { id, title, poster = "maxresdefault" } = Astro.props;
if (!/^[A-Za-z0-9_-]{11}$/.test(id)) {
  throw new Error(`YouTubeFacade: invalid YouTube video id: ${id}`);
}
const posterUrl = `https://i.ytimg.com/vi/${id}/${poster}.jpg`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
const watchUrl = `https://www.youtube.com/watch?v=${id}`;
---

<div class="yt-facade" data-embed={embedUrl} data-title={title}>
  <img
    src={posterUrl}
    alt={`Video poster: ${title}`}
    width="1280"
    height="720"
    loading="lazy"
  />
  <button type="button" aria-label={`Play video: ${title}`}>
    <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
      <path
        d="M66.52 7.74a8.4 8.4 0 0 0-5.9-5.96C55.4.86 34 .86 34 .86s-21.4 0-26.62.92a8.4 8.4 0 0 0-5.9 5.96C.56 13.05.56 24 .56 24s0 10.95.92 16.26a8.4 8.4 0 0 0 5.9 5.96c5.22.92 26.62.92 26.62.92s21.4 0 26.62-.92a8.4 8.4 0 0 0 5.9-5.96c.92-5.31.92-16.26.92-16.26s0-10.95-.92-16.26z"
        fill="currentColor"
      ></path>
      <path d="M45 24 27 14v20z" fill="#fff"></path>
    </svg>
  </button>
  <noscript>
    <a href={watchUrl} rel="noopener noreferrer">Watch on YouTube: {title}</a>
  </noscript>
</div>

<script>
  for (const el of document.querySelectorAll<HTMLElement>(".yt-facade")) {
    el.querySelector("button")?.addEventListener(
      "click",
      () => {
        const iframe = document.createElement("iframe");
        iframe.src = el.dataset.embed ?? "";
        iframe.title = el.dataset.title ?? "YouTube video";
        iframe.allow =
          "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
        iframe.allowFullscreen = true;
        el.replaceChildren(iframe);
        el.classList.add("is-playing");
      },
      { once: true },
    );
  }
</script>

<style>
  .yt-facade {
    position: relative;
    margin: 36px 0;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 4px;
    overflow: hidden;
  }
  .yt-facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .yt-facade button {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.12);
    border: 0;
    cursor: pointer;
    color: rgba(23, 23, 23, 0.82);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .yt-facade button:hover {
    color: #e33;
    background: rgba(0, 0, 0, 0.04);
  }
  .yt-facade.is-playing iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
