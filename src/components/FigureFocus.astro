---
// Figure focus (2026-10-01) — the in-page focus view for every figure on a
// page. Default = the WHOLE figure fitted to the screen (both axes, centered);
// zoom runs from 25 % to 800 % of that fit (buttons, ctrl/cmd+wheel = trackpad
// pinch, touch pinch, double-tap), pan by drag / touch / scroll; the full
// caption sits under the stage, readable; download (the attributed SVG with
// the caption burned in, for house figures), copy-link, Esc/Back close.
// Scott's review folds (2026-10-01): fit means fit, minus works below fit,
// the caption is never clipped, the download carries the caption; the zoom
// buttons walk a FIXED grid (25 50 75 100 125 150 175 200 250 300 400 500 600
// 800 %) with one special rung: the first + from the whole figure goes to
// FULL WIDTH, top-aligned; on phones the toolbar is Download + Copy link +
// close — zoom and pan are the phone's own gestures.
// The stage shows the CLEAN figure: the page's inline <svg> is cloned (vector
// at every zoom, no fetch; ids suffixed so url(#…) refs stay unambiguous) or
// the raster <img>; the download link points at the derivative.
// Progressive enhancement over the `a.fig-open` links Figure.astro and
// rehype-figure-focus.mjs emit — with JS off the links open the download.
// Included ONCE per page that renders figures ([slug].astro, /figures); the
// AIO gate licenses exactly this script by SHAPE (the compiled module that
// carries "figfocus", inline or as one hashed /_astro/ module) on exactly the
// pages whose markup carries <dialog class="figfocus"> + a data-figure figure.
// Dependency-free by design (the estate ships no JS libraries). Zoom is
// LAYOUT zoom (the element's width/height), pan is the stage's own scroll;
// when the figure is smaller than the stage it centers via margin:auto.
---

<dialog class="figfocus" id="figfocus" aria-labelledby="figfocus-caption" data-figfocus>
  <div class="figfocus-bar">
    <div class="figfocus-tools" role="group" aria-label="Figure tools">
      <button type="button" data-act="out" aria-label="Zoom out" title="Zoom out (-)">&minus;</button>
      <output class="figfocus-zoom" aria-live="polite" aria-label="Zoom level">100%</output>
      <button type="button" data-act="in" aria-label="Zoom in" title="Zoom in (+)">+</button>
      <button type="button" data-act="fit" title="Fit the whole figure on screen (0)">Fit</button>
      <a class="figfocus-dl" href="#" download>Download SVG</a>
      <button type="button" data-act="link" title="Copy a link to this figure">Copy link</button>
      <button type="button" data-act="close" aria-label="Close" title="Close (Esc)">&times;</button>
    </div>
  </div>
  <div class="figfocus-stage" tabindex="0" aria-describedby="figfocus-caption"></div>
  <p class="figfocus-caption" id="figfocus-caption"></p>
</dialog>

<script>
  const dlg = document.getElementById("figfocus") as HTMLDialogElement | null;
  if (dlg && typeof dlg.showModal === "function") {
    const q = <T extends Element>(s: string) => dlg.querySelector(s) as T;
    const stage = q<HTMLElement>(".figfocus-stage");
    const cap = q<HTMLElement>(".figfocus-caption");
    const zoomOut = q<HTMLOutputElement>(".figfocus-zoom");
    const dl = q<HTMLAnchorElement>(".figfocus-dl");
    const linkBtn = q<HTMLButtonElement>('[data-act="link"]');
    const MIN = 0.25;
    const MAX = 8;
    const PAD = 16;
    let el: HTMLElement | null = null; // the stage content (svg clone or img)
    let natW = 1;
    let natH = 1;
    let fitScale = 1; // css px per intrinsic unit when the whole figure fits
    let zoom = 1; // relative to the fit: 1 = whole figure on screen
    let figId = "";
    let opener: HTMLElement | null = null;
    let pushed = false;
    let viaHistory = false;
    let lastPointerType = "";
    let suppressDbl = 0;
    let backPending = false;
    let closeSeq = 0;
    let pendingOpen: HTMLAnchorElement | null = null;
    let lockY = 0;
    let prevRestoration: ScrollRestoration = "auto";

    // A reload while the dialog was open left scrollRestoration "manual" on
    // the entry, and Chrome then skips the fragment scroll on EVERY later load
    // (Scott: "refreshing the # link takes me to top of page, not the fig").
    // Reset it, and scroll to a figure named by the hash ourselves.
    const scrollToHashFigure = () => {
      if (!location.hash) return;
      let hashId = "";
      try {
        hashId = decodeURIComponent(location.hash.slice(1));
      } catch {
        return; // malformed percent-encoding ("#%") — nothing to scroll to (round-2 K3 F2)
      }
      const t = document.getElementById(hashId);
      if (t && t.matches("figure.post-figure")) requestAnimationFrame(() => t.scrollIntoView({ block: "start" }));
    };
    // The entry an open pushed carries state {figfocus}. Reaching it by RELOAD
    // means Chrome restores that entry's saved offset — 0, the body was locked —
    // at its load-time restore step, AFTER our first-frame scroll (measured
    // under 400 ms latency: scroll 6197 → load → 0; round-3 fable F1 — warm
    // caches hide it). Keep restoration OFF until load has passed, scroll to
    // the figure ourselves at init AND at load, then hand the mode back.
    if (history.state && history.state.figfocus) {
      history.scrollRestoration = "manual";
      const handBack = () => {
        scrollToHashFigure();
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            if (!dlg.open) history.scrollRestoration = "auto";
          }),
        );
      };
      if (document.readyState === "complete") handBack();
      else window.addEventListener("load", handBack, { once: true });
    } else if (history.scrollRestoration === "manual") history.scrollRestoration = "auto";
    scrollToHashFigure();
    window.addEventListener("pagehide", () => {
      if (dlg.open) history.scrollRestoration = prevRestoration;
    });
    const dims = () => ({ w: natW * fitScale * zoom, h: natH * fitScale * zoom });
    const margins = (w: number, h: number) => ({
      ml: Math.max(0, (stage.clientWidth - w) / 2),
      mt: Math.max(0, (stage.clientHeight - h) / 2),
    });
    const size = () => {
      if (!el) return;
      const { w, h } = dims();
      el.style.width = `${Math.round(w)}px`;
      el.style.height = `${Math.round(h)}px`;
    };
    const computeFit = () => {
      fitScale = Math.max(0.001, Math.min((stage.clientWidth - 2 * PAD) / natW, (stage.clientHeight - 2 * PAD) / natH));
    };
    // The zoom at which the figure spans the stage's full width (>= 1).
    const fitWidth = () => Math.min(MAX, Math.max(1, (stage.clientWidth - 2 * PAD) / (natW * fitScale))); // clamped like apply() (round-2 glmflash F1)
    // The grid (Scott: "normal increments, ie 125, 150, 175"); the first +
    // from the whole figure is the one off-grid rung: full width, top-aligned.
    const GRID = [0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75, 2, 2.5, 3, 4, 5, 6, 8];
    const stepIn = (z: number): { z: number; top: boolean } => {
      const fw = fitWidth();
      if (Math.abs(z - 1) < 0.01 && fw > 1.1) return { z: fw, top: true };
      return { z: GRID.find((g) => g > z + 0.01) ?? z, top: false };
    };
    // From the full-width rung, - returns to the whole figure (quick review,
    // client seat #1); otherwise the next grid value below. The rung is
    // REMEMBERED: at full width a vertical scrollbar narrows the stage, so a
    // fresh fitWidth() no longer equals the zoom that was applied.
    let fullWidthZ = 0;
    const stepOut = (z: number) => {
      const fw = fitWidth();
      if ((fullWidthZ && Math.abs(z - fullWidthZ) < 0.01) || (fw > 1.1 && Math.abs(z - fw) < 0.01)) return 1;
      return [...GRID].reverse().find((g) => g < z - 0.01) ?? z;
    };
    const zoomStep = (dir: 1 | -1) => {
      if (dir > 0) {
        const s = stepIn(zoom);
        if (s.top) fullWidthZ = s.z;
        apply(s.z);
        if (s.top) stage.scrollTo({ left: 0, top: 0 });
      } else apply(stepOut(zoom));
    };
    // Double-tap / double-click toggle: whole figure <-> full width (2.5x when
    // the figure is already width-bound at fit).
    const toggleZoom = () => {
      if (zoom > 1.01) return 1;
      const fw = fitWidth();
      if (fw > 1.1) {
        fullWidthZ = fw;
        return fw;
      }
      return 2.5;
    };
    // Zoom about a stage point (px,py in stage client coords); dx/dy = how far
    // that anchor itself moved since the last call (a pinch's midpoint).
    // Content coordinates account for the centering margins on both sides.
    const apply = (z: number, px?: number, py?: number, dx = 0, dy = 0) => {
      z = Math.min(MAX, Math.max(MIN, z));
      const r = z / zoom;
      const { w: w0, h: h0 } = dims();
      const { ml: ml0, mt: mt0 } = margins(w0, h0);
      const ax = px ?? stage.clientWidth / 2;
      const ay = py ?? stage.clientHeight / 2;
      const cx = stage.scrollLeft + ax - ml0 - dx;
      const cy = stage.scrollTop + ay - mt0 - dy;
      zoom = z;
      size();
      const { w: w1, h: h1 } = dims();
      const { ml: ml1, mt: mt1 } = margins(w1, h1);
      stage.scrollLeft = cx * r + ml1 - ax;
      stage.scrollTop = cy * r + mt1 - ay;
      zoomOut.value = `${Math.round(zoom * 100)}%`;
    };
    // Re-fit on resize/rotation keeping the stage's center on the same spot.
    const refit = () => {
      if (!el) return;
      const { w: w0, h: h0 } = dims();
      const { ml: ml0, mt: mt0 } = margins(w0, h0);
      const cx = (stage.scrollLeft + stage.clientWidth / 2 - ml0) / w0;
      const cy = (stage.scrollTop + stage.clientHeight / 2 - mt0) / h0;
      computeFit();
      size();
      const { w: w1, h: h1 } = dims();
      const { ml: ml1, mt: mt1 } = margins(w1, h1);
      stage.scrollLeft = cx * w1 + ml1 - stage.clientWidth / 2;
      stage.scrollTop = cy * h1 + mt1 - stage.clientHeight / 2;
    };
    const ready = () => {
      zoom = 1;
      fullWidthZ = 0; // the rung is per figure (round-2 K3 F3 / chair C1)
      computeFit();
      size();
      stage.scrollTo(0, 0);
      zoomOut.value = "100%";
    };
    // Clone the page's inline svg with every id suffixed (url(#…)/href refs too).
    // A DOM clone (no serialize/reparse: outerHTML emits &nbsp;, which XML
    // parsing rejects — quick review, client seat #3) with every id suffixed
    // and url(#…) / href="#…" references rewritten to match.
    const REF_ATTRS = ["fill", "stroke", "marker-start", "marker-mid", "marker-end", "clip-path", "mask", "filter", "style", "href", "xlink:href"];
    const cloneSvg = (svg: SVGElement): SVGElement => {
      const clone = svg.cloneNode(true) as SVGElement;
      const map = new Map<string, string>();
      if (clone.id) {
        map.set(clone.id, `${clone.id}-ff`); // querySelectorAll skips the root (round-2 glmflash F4)
        clone.id = `${clone.id}-ff`;
      }
      for (const n of clone.querySelectorAll("[id]")) {
        if (!n.id) continue;
        map.set(n.id, `${n.id}-ff`);
        n.id = `${n.id}-ff`;
      }
      if (map.size) {
        for (const n of [clone, ...clone.querySelectorAll("*")]) {
          for (const a of REF_ATTRS) {
            const v = n.getAttribute(a);
            if (!v) continue;
            let nv = v.replace(/url\((['"]?)#([^)'"]+)\1\)/g, (m, q: string, id: string) => (map.has(id) ? `url(${q}#${map.get(id)}${q})` : m));
            if ((a === "href" || a === "xlink:href") && v.startsWith("#") && map.has(v.slice(1))) nv = `#${map.get(v.slice(1))}`;
            if (nv !== v) n.setAttribute(a, nv);
          }
        }
        for (const st of clone.querySelectorAll("style"))
          st.textContent = (st.textContent ?? "").replace(/#([A-Za-z_][\w:.-]*)/g, (m, id: string) => {
            if (map.has(id)) return `#${map.get(id)}`;
            const cut = id.search(/[:.]/); // `#id:hover`, `#id.cls` (round-2 grok F11)
            const base = cut > 0 ? id.slice(0, cut) : "";
            return base && map.has(base) ? `#${map.get(base)}${id.slice(cut)}` : m;
          });
      }
      return clone;
    };
    // "Figure N." = the figure's ordinal among the page's CAPTIONED figures
    // (the same rule as the caption labels' CSS counter).
    const figureLabel = (fig: Element | null) => {
      if (!fig || !fig.closest(".prose")) return "";
      const captioned = [...document.querySelectorAll("figure.post-figure")].filter(
        (f) => !f.classList.contains("post-figure--img") || f.hasAttribute("aria-labelledby"),
      );
      const n = captioned.indexOf(fig);
      return n >= 0 ? `Figure ${n + 1}.` : "";
    };

    const open = (a: HTMLAnchorElement) => {
      // A close's back() still in flight: open once its popstate has landed
      // (a pushState racing a pending traversal leaves Chrome's entries in
      // an inconsistent order — quick review, client seat; race probe).
      // …or a close whose queued `close` event has not run yet
      // (`dialog.close()` drops `open` synchronously, the event fires in a
      // later task): its cleanup would erase this open's stage and traverse
      // the wrong entry (round-2 astra F2). `pushed` is reset only there.
      if (backPending || (!dlg.open && pushed)) {
        pendingOpen = a;
        return;
      }
      const fig = a.closest("figure");
      figId = fig?.id ?? "";
      opener = a;
      const svgEl = a.querySelector("svg");
      const imgEl = a.querySelector("img");
      const alt = svgEl?.getAttribute("aria-label") ?? imgEl?.getAttribute("alt") ?? "";
      const text = (fig?.querySelector(".fig-cap")?.textContent ?? "").trim() || alt;
      const label = figureLabel(fig);
      cap.replaceChildren();
      if (label) {
        const b = document.createElement("strong");
        b.textContent = label;
        cap.append(b, " ");
      }
      cap.append(text);
      if (cap.textContent?.trim()) {
        dlg.setAttribute("aria-labelledby", "figfocus-caption");
        dlg.removeAttribute("aria-label");
      } else {
        dlg.removeAttribute("aria-labelledby");
        dlg.setAttribute("aria-label", alt || "Figure focus view");
      }
      dl.href = a.href;
      dl.download = a.dataset.download ?? "";
      dl.textContent = /\.svg(\?|$)/i.test(a.href) ? "Download SVG" : "Download image";
      // Every open owns ONE history entry — also when the page was reached
      // via this very deep link, or Back would leave the page. Push BEFORE
      // the body lock: the lock clamps window.scrollY to 0 and the browser
      // would persist that into the entry being left.
      lockY = window.scrollY;
      pushed = false;
      // Scroll restoration goes MANUAL on the entry we are about to leave,
      // BEFORE the push (the new entry inherits it; set again after): our own
      // back() then lands on that entry without Chrome re-aiming the page at
      // its fragment AFTER popstate (measured: popstate 1822 → hashchange 922
      // — the deep-link arrival path; round-2 grok F1 / fable F1, second
      // half). The popstate branch restores the mode once we are back.
      // A "manual" found here is OURS (the init guard resets any other at load):
      // a deferred re-open must keep the ORIGINAL mode to restore.
      if (history.scrollRestoration !== "manual") prevRestoration = history.scrollRestoration;
      history.scrollRestoration = "manual";
      if (figId) {
        history.pushState({ figfocus: figId }, "", `#${figId}`);
        pushed = true;
      }
      history.scrollRestoration = "manual";
      document.documentElement.classList.add("figfocus-open");
      document.body.style.top = `-${lockY}px`;
      if (!dlg.open) dlg.showModal();
      // Content: the clean inline svg (vector) or the raster image.
      stage.replaceChildren();
      el = null;
      ptrs.clear(); // a pointer still captured at close must not seed the next open's gesture (round-2 glmfull F7)
      cancelPinchFrame();
      moved = 0;
      const clone = svgEl ? cloneSvg(svgEl) : null;
      // A click that turns into a double-click must not zoom the fresh view.
      suppressDbl = Date.now();
      if (clone) {
        const vb = (clone.getAttribute("viewBox") ?? "").trim().split(/[\s,]+/).map(Number);
        natW = vb.length === 4 && vb[2] > 0 ? vb[2] : svgEl!.clientWidth || 1;
        natH = vb.length === 4 && vb[3] > 0 ? vb[3] : svgEl!.clientHeight || 1;
        clone.removeAttribute("role");
        clone.setAttribute("aria-hidden", "true");
        clone.classList.add("figfocus-img");
        el = clone as unknown as HTMLElement;
        stage.append(el);
        ready();
      } else {
        const img = new Image();
        img.className = "figfocus-img";
        img.alt = alt;
        img.draggable = false;
        img.decoding = "async";
        img.onerror = () => {
          if (el !== img || !dlg.open) return; // a removed image's late callback (round-2 astra F5)
          cap.textContent = "The image failed to load.";
        };
        img.onload = () => {
          if (el !== img || !dlg.open) return;
          natW = img.naturalWidth || 1;
          natH = img.naturalHeight || 1;
          ready();
        };
        img.src = imgEl?.currentSrc || imgEl?.src || a.href;
        el = img;
        stage.append(el);
      }
      stage.focus({ preventScroll: true });
    };
    dlg.addEventListener("close", () => {
      document.documentElement.classList.remove("figfocus-open");
      document.body.style.top = "";
      window.scrollTo(0, lockY);
      // Restore the mode here only when we are NOT about to traverse: Chrome
      // applies the mode in effect at back() time to the LANDING entry
      // (measured — restoring "auto" here made the arrival entry fragment-
      // scroll after popstate), so with our own back() in flight it stays
      // manual and the popstate branch restores it after landing.
      if (!(pushed && !viaHistory)) history.scrollRestoration = prevRestoration;
      cancelPinchFrame(); // gesture state dies with the view (round-2 astra F1 / glmfull F7)
      ptrs.clear();
      lastTap = 0;
      stage.replaceChildren();
      el = null;
      if (pushed && !viaHistory) {
        backPending = true;
        history.back();
        // Watchdog: if the traversal never reports, release the latch — and
        // DROP the deferred open rather than run it: a merely SLOW back()
        // would deliver its popstate after that open and close the fresh
        // dialog (the race in a new costume — round-2 inkling/K3/deepseek/
        // glmfull/glmflash/astra, convergent). A lost click is the cheap
        // direction; the user clicks again. The timer is THIS close's own
        // (`seq`): an older close's timer never releases a newer latch.
        const seq = ++closeSeq;
        setTimeout(() => {
          if (!backPending || seq !== closeSeq) return;
          backPending = false;
          pendingOpen = null;
          history.scrollRestoration = prevRestoration; // no traversal is coming — do not strand "manual" (round-3 astra F2 / K3 F5)
        }, 400);
      }
      pushed = false;
      viaHistory = false;
      opener?.focus({ preventScroll: true });
      // A click that arrived inside the close window runs now when no
      // traversal is pending (the popstate path runs it otherwise).
      if (!backPending && pendingOpen) {
        const next = pendingOpen;
        pendingOpen = null;
        open(next);
      }
    });
    window.addEventListener("popstate", () => {
      // The back() we queued at close has landed on the page's own entry;
      // an open that arrived meanwhile runs now (and pushes normally).
      if (backPending) {
        backPending = false;
        // Back on the entry whose mode went manual at open: restore it a FRAME
        // later — Chrome's post-popstate fragment-scroll step reads the mode
        // after these listeners ran (measured: a synchronous restore let it
        // re-aim the page at the arrival figure) — and only if no deferred
        // open re-opened meanwhile (that open's own close restores it).
        const mode = prevRestoration;
        const seqAtLanding = closeSeq;
        requestAnimationFrame(() => {
          // this traversal's own frame only — never inside a newer close window
          // or a newer traversal (round-3 astra F1)
          if (seqAtLanding === closeSeq && !dlg.open && !pushed && !backPending) history.scrollRestoration = mode;
        });
        if (pendingOpen) {
          const a = pendingOpen;
          pendingOpen = null;
          open(a);
        }
        // Our own traversal: the close handler already restored the scroll;
        // falling through would scroll to a `#fig-` hash the entry we return
        // to still carries (the deep-link arrival path — round-2 grok F1).
        return;
      }
      if (dlg.open) {
        viaHistory = true;
        dlg.close();
      } else {
        // a stale "manual" of ours (a reload while open, a typed hash, a Back
        // inside the restore frame) heals on the next landing (round-3 fable F2)
        if (history.scrollRestoration === "manual") history.scrollRestoration = "auto";
        scrollToHashFigure();
      }
    });
    // Plain clicks open the focus view; modifier clicks keep the native link.
    document.addEventListener("click", (e) => {
      const a = (e.target as Element).closest?.("a.fig-open") as HTMLAnchorElement | null;
      if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      open(a);
    });
    dlg.addEventListener("click", (e) => {
      const btn = (e.target as Element).closest?.("button[data-act]") as HTMLButtonElement | null;
      if (!btn) return;
      const act = btn.dataset.act;
      if (act === "in") zoomStep(1);
      else if (act === "out") zoomStep(-1);
      else if (act === "fit") apply(1);
      else if (act === "close") dlg.close();
    });
    linkBtn.addEventListener("click", async () => {
      // Prefer the figure's in-post deep link (the /figures cards carry one).
      const figKey = opener?.closest("figure")?.getAttribute("data-figure") ?? figId;
      const inPost = opener?.closest("figure")?.querySelector<HTMLAnchorElement>(`a[href*="/blog/"][href$="#${figKey}"]`);
      const url = inPost ? new URL(inPost.getAttribute("href") ?? "", location.origin).href : `${location.origin}${location.pathname}#${figId}`;
      try {
        await navigator.clipboard.writeText(url);
        linkBtn.textContent = "Copied";
        setTimeout(() => (linkBtn.textContent = "Copy link"), 1600);
      } catch {
        window.prompt("Link to this figure", url);
      }
    });
    dlg.addEventListener("keydown", (e) => {
      if (e.key === "+" || e.key === "=") zoomStep(1);
      else if (e.key === "-" || e.key === "_") zoomStep(-1);
      else if (e.key === "0") apply(1);
      else return;
      e.preventDefault();
    });

    // Pointers: one = drag-pan (touch-action none on the stage keeps the
    // browser out), two = pinch about the moving midpoint.
    const ptrs = new Map<number, { x: number; y: number }>();
    let pinch0 = 0;
    let zoom0 = 1;
    let pinchX = 0;
    let pinchY = 0;
    // Pinch updates are COALESCED per animation frame from the latest known
    // position of BOTH contacts: a stationary finger emits no pointermove, so
    // waiting for "both fingers reported" froze the anchored pinch (round-2
    // astra F1 — probe: one finger still, the other moving, zoom stayed
    // 100 %); one frame = one apply, so the two moves a touch frame emits no
    // longer land as two half-updates (quick review, client seat #6).
    let pinchFrame: number | null = null;
    const cancelPinchFrame = () => {
      if (pinchFrame !== null) cancelAnimationFrame(pinchFrame);
      pinchFrame = null;
    };
    const flushPinch = () => {
      pinchFrame = null;
      if (ptrs.size !== 2 || !dlg.open) return;
      const [a, b] = [...ptrs.values()];
      const r = rectOf();
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      const mx = (a.x + b.x) / 2;
      const my = (a.y + b.y) / 2;
      apply((zoom0 * d) / pinch0, mx - r.left, my - r.top, mx - pinchX, my - pinchY);
      pinchX = mx;
      pinchY = my;
    };
    let lastX = 0;
    let lastY = 0;
    let lastTap = 0;
    let moved = 0;
    const rectOf = () => stage.getBoundingClientRect();
    stage.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      lastPointerType = e.pointerType;
      stage.setPointerCapture(e.pointerId);
      ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (ptrs.size === 2) {
        const [a, b] = [...ptrs.values()];
        pinch0 = Math.hypot(a.x - b.x, a.y - b.y) || 1;
        zoom0 = zoom;
        pinchX = (a.x + b.x) / 2;
        pinchY = (a.y + b.y) / 2;
        cancelPinchFrame();
      } else {
        lastX = e.clientX;
        lastY = e.clientY;
        moved = 0;
      }
    });
    stage.addEventListener("pointermove", (e) => {
      if (!ptrs.has(e.pointerId)) return;
      ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (ptrs.size === 2) {
        if (pinchFrame === null) pinchFrame = requestAnimationFrame(flushPinch);
      } else if (ptrs.size === 1) {
        stage.scrollLeft -= e.clientX - lastX;
        stage.scrollTop -= e.clientY - lastY;
        moved += Math.abs(e.clientX - lastX) + Math.abs(e.clientY - lastY);
        lastX = e.clientX;
        lastY = e.clientY;
      }
    });
    const lift = (e: PointerEvent) => {
      if (!ptrs.has(e.pointerId)) return;
      if (pinchFrame !== null) {
        cancelPinchFrame();
        flushPinch(); // the last pending pinch lands before the contact leaves
      }
      ptrs.delete(e.pointerId);
      if (ptrs.size === 2) {
        // a third contact lifted: re-seed the pinch from the pair that is
        // actually down, or the next frame jumps by d_new/d_old (round-3
        // astra F3 / K3 F1 / fable F3)
        const [pa, pb] = [...ptrs.values()];
        pinch0 = Math.hypot(pa.x - pb.x, pa.y - pb.y) || 1;
        zoom0 = zoom;
        pinchX = (pa.x + pb.x) / 2;
        pinchY = (pa.y + pb.y) / 2;
      }
      const rest = [...ptrs.values()][0];
      if (rest) {
        lastX = rest.x;
        lastY = rest.y;
        moved = 9;
      } else if (e.type === "pointerup" && e.pointerType === "touch" && moved < 8) {
        // Double-tap toggles fit <-> 2.5x about the tap (mouse uses dblclick).
        const now = Date.now();
        if (now - lastTap < 320) {
          const r = rectOf();
          apply(toggleZoom(), e.clientX - r.left, e.clientY - r.top);
          lastTap = 0;
          suppressDbl = Date.now();
        } else lastTap = now;
      }
    };
    // The browser's own image drag would cancel the pan.
    stage.addEventListener("dragstart", (e) => e.preventDefault());
    stage.addEventListener("pointerup", lift);
    stage.addEventListener("pointercancel", lift);
    // `dblclick` is a MouseEvent on every engine (no pointerType): gate it by
    // the last pointer type + the touch detector's timestamp.
    stage.addEventListener("dblclick", (e) => {
      if (lastPointerType === "touch" || Date.now() - suppressDbl < 700) return;
      const r = rectOf();
      apply(toggleZoom(), e.clientX - r.left, e.clientY - r.top);
    });
    // ctrl/cmd + wheel (what a trackpad pinch emits) zooms about the cursor;
    // a plain wheel pans — the stage is an ordinary scroll container.
    stage.addEventListener(
      "wheel",
      (e) => {
        if (!(e.ctrlKey || e.metaKey)) return;
        e.preventDefault();
        const r = rectOf();
        const d = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * 400 : e.deltaY;
        const k = Math.min(2, Math.max(0.5, Math.exp(-d * 0.0025)));
        apply(zoom * k, e.clientX - r.left, e.clientY - r.top);
      },
      { passive: false },
    );
    // WebKit GestureEvents: iOS — keep a pinch from zooming the page; macOS
    // Safari — a trackpad pinch arrives HERE (not as ctrl+wheel).
    let g0 = 1;
    stage.addEventListener("gesturestart", (e) => {
      e.preventDefault();
      g0 = zoom;
    });
    stage.addEventListener("gesturechange", (e) => {
      e.preventDefault();
      const ge = e as Event & { scale: number; clientX: number; clientY: number };
      if (lastPointerType === "touch" || !ge.scale) return;
      const r = rectOf();
      apply(g0 * ge.scale, ge.clientX - r.left, ge.clientY - r.top);
    });
    window.addEventListener("resize", () => {
      if (dlg.open) refit();
    });
  }
</script>

