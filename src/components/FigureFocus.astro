---
// Figure focus (2026-10-01) — the in-page focus view for every figure on a
// page. Default = the WHOLE figure fitted to the screen (both axes, centered);
// zoom runs from 25 % to 800 % of that fit (buttons, ctrl/cmd+wheel = trackpad
// pinch, touch pinch, double-tap), pan by drag / touch / scroll; the full
// caption sits under the stage, readable; download (the attributed SVG with
// the caption burned in, for house figures), copy-link, Esc/Back close.
// Scott's review folds (2026-10-01): fit means fit, minus works below fit,
// the caption is never clipped, the download carries the caption.
// The stage shows the CLEAN figure: the page's inline <svg> is cloned (vector
// at every zoom, no fetch; ids suffixed so url(#…) refs stay unambiguous) or
// the raster <img>; the download link points at the derivative.
// Progressive enhancement over the `a.fig-open` links Figure.astro and
// rehype-figure-focus.mjs emit — with JS off the links open the download.
// Included ONCE per page that renders figures ([slug].astro, /figures); the
// AIO gate licenses exactly this script by SHAPE (the compiled module that
// carries "figfocus", inline or as one hashed /_astro/ module) on exactly the
// pages whose markup carries <dialog class="figfocus"> + a data-figure figure.
// Dependency-free by design (the estate ships no JS libraries). Zoom is
// LAYOUT zoom (the element's width/height), pan is the stage's own scroll;
// when the figure is smaller than the stage it centers via margin:auto.
---

<dialog class="figfocus" id="figfocus" aria-labelledby="figfocus-caption" data-figfocus>
  <div class="figfocus-bar">
    <div class="figfocus-tools" role="group" aria-label="Figure tools">
      <button type="button" data-act="out" aria-label="Zoom out" title="Zoom out (-)">&minus;</button>
      <output class="figfocus-zoom" aria-live="polite" aria-label="Zoom level">100%</output>
      <button type="button" data-act="in" aria-label="Zoom in" title="Zoom in (+)">+</button>
      <button type="button" data-act="fit" title="Fit the whole figure on screen (0)">Fit</button>
      <a class="figfocus-dl" href="#" download>Download SVG</a>
      <button type="button" data-act="link" title="Copy a link to this figure">Copy link</button>
      <button type="button" data-act="close" aria-label="Close" title="Close (Esc)">&times;</button>
    </div>
  </div>
  <div class="figfocus-stage" tabindex="0" aria-describedby="figfocus-caption"></div>
  <p class="figfocus-caption" id="figfocus-caption"></p>
</dialog>

<script>
  const dlg = document.getElementById("figfocus") as HTMLDialogElement | null;
  if (dlg && typeof dlg.showModal === "function") {
    const q = <T extends Element>(s: string) => dlg.querySelector(s) as T;
    const stage = q<HTMLElement>(".figfocus-stage");
    const cap = q<HTMLElement>(".figfocus-caption");
    const zoomOut = q<HTMLOutputElement>(".figfocus-zoom");
    const dl = q<HTMLAnchorElement>(".figfocus-dl");
    const linkBtn = q<HTMLButtonElement>('[data-act="link"]');
    const MIN = 0.25;
    const MAX = 8;
    const PAD = 16;
    let el: HTMLElement | null = null; // the stage content (svg clone or img)
    let natW = 1;
    let natH = 1;
    let fitScale = 1; // css px per intrinsic unit when the whole figure fits
    let zoom = 1; // relative to the fit: 1 = whole figure on screen
    let figId = "";
    let opener: HTMLElement | null = null;
    let pushed = false;
    let viaHistory = false;
    let lastPointerType = "";
    let suppressDbl = 0;
    let backPending = false;
    let lockY = 0;
    let prevRestoration: ScrollRestoration = "auto";

    const dims = () => ({ w: natW * fitScale * zoom, h: natH * fitScale * zoom });
    const margins = (w: number, h: number) => ({
      ml: Math.max(0, (stage.clientWidth - w) / 2),
      mt: Math.max(0, (stage.clientHeight - h) / 2),
    });
    const size = () => {
      if (!el) return;
      const { w, h } = dims();
      el.style.width = `${Math.round(w)}px`;
      el.style.height = `${Math.round(h)}px`;
    };
    const computeFit = () => {
      fitScale = Math.max(0.001, Math.min((stage.clientWidth - 2 * PAD) / natW, (stage.clientHeight - 2 * PAD) / natH));
    };
    // Zoom about a stage point (px,py in stage client coords); dx/dy = how far
    // that anchor itself moved since the last call (a pinch's midpoint).
    // Content coordinates account for the centering margins on both sides.
    const apply = (z: number, px?: number, py?: number, dx = 0, dy = 0) => {
      z = Math.min(MAX, Math.max(MIN, z));
      const r = z / zoom;
      const { w: w0, h: h0 } = dims();
      const { ml: ml0, mt: mt0 } = margins(w0, h0);
      const ax = px ?? stage.clientWidth / 2;
      const ay = py ?? stage.clientHeight / 2;
      const cx = stage.scrollLeft + ax - ml0 - dx;
      const cy = stage.scrollTop + ay - mt0 - dy;
      zoom = z;
      size();
      const { w: w1, h: h1 } = dims();
      const { ml: ml1, mt: mt1 } = margins(w1, h1);
      stage.scrollLeft = cx * r + ml1 - ax;
      stage.scrollTop = cy * r + mt1 - ay;
      zoomOut.value = `${Math.round(zoom * 100)}%`;
    };
    // Re-fit on resize/rotation keeping the stage's center on the same spot.
    const refit = () => {
      if (!el) return;
      const { w: w0, h: h0 } = dims();
      const { ml: ml0, mt: mt0 } = margins(w0, h0);
      const cx = (stage.scrollLeft + stage.clientWidth / 2 - ml0) / w0;
      const cy = (stage.scrollTop + stage.clientHeight / 2 - mt0) / h0;
      computeFit();
      size();
      const { w: w1, h: h1 } = dims();
      const { ml: ml1, mt: mt1 } = margins(w1, h1);
      stage.scrollLeft = cx * w1 + ml1 - stage.clientWidth / 2;
      stage.scrollTop = cy * h1 + mt1 - stage.clientHeight / 2;
    };
    const ready = () => {
      zoom = 1;
      computeFit();
      size();
      stage.scrollTo(0, 0);
      zoomOut.value = "100%";
    };
    // Clone the page's inline svg with every id suffixed (url(#…)/href refs too).
    const cloneSvg = (svg: SVGElement): SVGElement | null => {
      const ids = [...svg.querySelectorAll("[id]")].map((n) => n.id).filter(Boolean);
      let html = svg.outerHTML;
      for (const id of ids) {
        const e = id.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        html = html
          .replace(new RegExp(`\\bid="${e}"`, "g"), `id="${id}-ff"`)
          .replace(new RegExp(`url\\(#${e}\\)`, "g"), `url(#${id}-ff)`)
          .replace(new RegExp(`href="#${e}"`, "g"), `href="#${id}-ff"`);
      }
      const doc = new DOMParser().parseFromString(html, "image/svg+xml");
      const root = doc.documentElement;
      if (!root || root.nodeName === "parsererror" || root.querySelector("parsererror")) return null;
      return document.importNode(root, true) as unknown as SVGElement;
    };
    // "Figure N." = the figure's ordinal among the page's CAPTIONED figures
    // (the same rule as the caption labels' CSS counter).
    const figureLabel = (fig: Element | null) => {
      if (!fig || !fig.closest(".prose")) return "";
      const captioned = [...document.querySelectorAll("figure.post-figure")].filter(
        (f) => !f.classList.contains("post-figure--img") || f.hasAttribute("aria-labelledby"),
      );
      const n = captioned.indexOf(fig);
      return n >= 0 ? `Figure ${n + 1}.` : "";
    };

    const open = (a: HTMLAnchorElement) => {
      const fig = a.closest("figure");
      figId = fig?.id ?? "";
      opener = a;
      const svgEl = a.querySelector("svg");
      const imgEl = a.querySelector("img");
      const alt = svgEl?.getAttribute("aria-label") ?? imgEl?.getAttribute("alt") ?? "";
      const text = (fig?.querySelector(".fig-cap")?.textContent ?? "").trim() || alt;
      const label = figureLabel(fig);
      cap.replaceChildren();
      if (label) {
        const b = document.createElement("strong");
        b.textContent = label;
        cap.append(b, " ");
      }
      cap.append(text);
      dl.href = a.href;
      dl.download = a.dataset.download ?? "";
      dl.textContent = /\.svg(\?|$)/i.test(a.href) ? "Download SVG" : "Download image";
      // Every open owns ONE history entry — also when the page was reached
      // via this very deep link, or Back would leave the page. Push BEFORE
      // the body lock: the lock clamps window.scrollY to 0 and the browser
      // would persist that into the entry being left.
      lockY = window.scrollY;
      pushed = false;
      if (figId) {
        history.pushState({ figfocus: figId }, "", `#${figId}`);
        pushed = true;
      }
      prevRestoration = history.scrollRestoration;
      history.scrollRestoration = "manual";
      document.documentElement.classList.add("figfocus-open");
      document.body.style.top = `-${lockY}px`;
      if (!dlg.open) dlg.showModal();
      // Content: the clean inline svg (vector) or the raster image.
      stage.replaceChildren();
      el = null;
      const clone = svgEl ? cloneSvg(svgEl) : null;
      if (clone) {
        const vb = (clone.getAttribute("viewBox") ?? "").trim().split(/[\s,]+/).map(Number);
        natW = vb.length === 4 && vb[2] > 0 ? vb[2] : svgEl!.clientWidth || 1;
        natH = vb.length === 4 && vb[3] > 0 ? vb[3] : svgEl!.clientHeight || 1;
        clone.removeAttribute("role");
        clone.setAttribute("aria-hidden", "true");
        clone.classList.add("figfocus-img");
        el = clone as unknown as HTMLElement;
        stage.append(el);
        ready();
      } else {
        const img = new Image();
        img.className = "figfocus-img";
        img.alt = alt;
        img.draggable = false;
        img.decoding = "async";
        img.onerror = () => {
          cap.textContent = "The image failed to load.";
        };
        img.onload = () => {
          natW = img.naturalWidth || 1;
          natH = img.naturalHeight || 1;
          ready();
        };
        img.src = imgEl?.currentSrc || imgEl?.src || a.href;
        el = img;
        stage.append(el);
      }
      stage.focus({ preventScroll: true });
    };
    dlg.addEventListener("close", () => {
      document.documentElement.classList.remove("figfocus-open");
      document.body.style.top = "";
      window.scrollTo(0, lockY);
      history.scrollRestoration = prevRestoration;
      stage.replaceChildren();
      el = null;
      if (pushed && !viaHistory) {
        backPending = true;
        history.back();
      }
      pushed = false;
      viaHistory = false;
      opener?.focus({ preventScroll: true });
    });
    window.addEventListener("popstate", () => {
      // A back() we queued at close may land after another figure opened —
      // re-pin that figure's hash instead of closing it.
      if (backPending) {
        backPending = false;
        if (dlg.open) {
          history.replaceState({ figfocus: figId }, "", `#${figId}`);
          pushed = true;
          return;
        }
      }
      if (dlg.open) {
        viaHistory = true;
        dlg.close();
      }
    });
    // Plain clicks open the focus view; modifier clicks keep the native link.
    document.addEventListener("click", (e) => {
      const a = (e.target as Element).closest?.("a.fig-open") as HTMLAnchorElement | null;
      if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      open(a);
    });
    dlg.addEventListener("click", (e) => {
      const btn = (e.target as Element).closest?.("button[data-act]") as HTMLButtonElement | null;
      if (!btn) return;
      const act = btn.dataset.act;
      if (act === "in") apply(zoom * 1.5);
      else if (act === "out") apply(zoom / 1.5);
      else if (act === "fit") apply(1);
      else if (act === "close") dlg.close();
    });
    linkBtn.addEventListener("click", async () => {
      // Prefer the figure's in-post deep link (the /figures cards carry one).
      const inPost = opener?.closest("figure")?.querySelector<HTMLAnchorElement>(`a[href$="#${figId}"]:not(.fig-anchor)`);
      const url = inPost ? new URL(inPost.getAttribute("href") ?? "", location.origin).href : `${location.origin}${location.pathname}#${figId}`;
      try {
        await navigator.clipboard.writeText(url);
        linkBtn.textContent = "Copied";
        setTimeout(() => (linkBtn.textContent = "Copy link"), 1600);
      } catch {
        window.prompt("Link to this figure", url);
      }
    });
    dlg.addEventListener("keydown", (e) => {
      if (e.key === "+" || e.key === "=") apply(zoom * 1.5);
      else if (e.key === "-" || e.key === "_") apply(zoom / 1.5);
      else if (e.key === "0") apply(1);
      else return;
      e.preventDefault();
    });

    // Pointers: one = drag-pan (touch-action none on the stage keeps the
    // browser out), two = pinch about the moving midpoint.
    const ptrs = new Map<number, { x: number; y: number }>();
    let pinch0 = 0;
    let zoom0 = 1;
    let pinchX = 0;
    let pinchY = 0;
    let lastX = 0;
    let lastY = 0;
    let lastTap = 0;
    let moved = 0;
    const rectOf = () => stage.getBoundingClientRect();
    stage.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      lastPointerType = e.pointerType;
      stage.setPointerCapture(e.pointerId);
      ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (ptrs.size === 2) {
        const [a, b] = [...ptrs.values()];
        pinch0 = Math.hypot(a.x - b.x, a.y - b.y) || 1;
        zoom0 = zoom;
        pinchX = (a.x + b.x) / 2;
        pinchY = (a.y + b.y) / 2;
      } else {
        lastX = e.clientX;
        lastY = e.clientY;
        moved = 0;
      }
    });
    stage.addEventListener("pointermove", (e) => {
      if (!ptrs.has(e.pointerId)) return;
      ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
      const r = rectOf();
      if (ptrs.size === 2) {
        const [a, b] = [...ptrs.values()];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        const mx = (a.x + b.x) / 2;
        const my = (a.y + b.y) / 2;
        apply((zoom0 * d) / pinch0, mx - r.left, my - r.top, mx - pinchX, my - pinchY);
        pinchX = mx;
        pinchY = my;
      } else {
        stage.scrollLeft -= e.clientX - lastX;
        stage.scrollTop -= e.clientY - lastY;
        moved += Math.abs(e.clientX - lastX) + Math.abs(e.clientY - lastY);
        lastX = e.clientX;
        lastY = e.clientY;
      }
    });
    const lift = (e: PointerEvent) => {
      if (!ptrs.has(e.pointerId)) return;
      ptrs.delete(e.pointerId);
      const rest = [...ptrs.values()][0];
      if (rest) {
        lastX = rest.x;
        lastY = rest.y;
        moved = 9;
      } else if (e.type === "pointerup" && e.pointerType === "touch" && moved < 8) {
        // Double-tap toggles fit <-> 2.5x about the tap (mouse uses dblclick).
        const now = Date.now();
        if (now - lastTap < 320) {
          const r = rectOf();
          apply(zoom > 1.01 ? 1 : 2.5, e.clientX - r.left, e.clientY - r.top);
          lastTap = 0;
          suppressDbl = Date.now();
        } else lastTap = now;
      }
    };
    // The browser's own image drag would cancel the pan.
    stage.addEventListener("dragstart", (e) => e.preventDefault());
    stage.addEventListener("pointerup", lift);
    stage.addEventListener("pointercancel", lift);
    // `dblclick` is a MouseEvent on every engine (no pointerType): gate it by
    // the last pointer type + the touch detector's timestamp.
    stage.addEventListener("dblclick", (e) => {
      if (lastPointerType === "touch" || Date.now() - suppressDbl < 700) return;
      const r = rectOf();
      apply(zoom > 1.01 ? 1 : 2.5, e.clientX - r.left, e.clientY - r.top);
    });
    // ctrl/cmd + wheel (what a trackpad pinch emits) zooms about the cursor;
    // a plain wheel pans — the stage is an ordinary scroll container.
    stage.addEventListener(
      "wheel",
      (e) => {
        if (!(e.ctrlKey || e.metaKey)) return;
        e.preventDefault();
        const r = rectOf();
        const d = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * 400 : e.deltaY;
        const k = Math.min(2, Math.max(0.5, Math.exp(-d * 0.0025)));
        apply(zoom * k, e.clientX - r.left, e.clientY - r.top);
      },
      { passive: false },
    );
    // WebKit GestureEvents: iOS — keep a pinch from zooming the page; macOS
    // Safari — a trackpad pinch arrives HERE (not as ctrl+wheel).
    let g0 = 1;
    stage.addEventListener("gesturestart", (e) => {
      e.preventDefault();
      g0 = zoom;
    });
    stage.addEventListener("gesturechange", (e) => {
      e.preventDefault();
      const ge = e as Event & { scale: number; clientX: number; clientY: number };
      if (lastPointerType === "touch" || !ge.scale) return;
      const r = rectOf();
      apply(g0 * ge.scale, ge.clientX - r.left, ge.clientY - r.top);
    });
    window.addEventListener("resize", () => {
      if (dlg.open) refit();
    });
  }
</script>

<style is:global>
  html.figfocus-open {
    overflow: hidden;
  }
  html.figfocus-open body {
    position: fixed;
    left: 0;
    right: 0;
    width: 100%;
  }
  .figfocus {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    display: none;
    flex-direction: column;
  }
  .figfocus[open] {
    display: flex;
  }
  .figfocus::backdrop {
    background: rgba(28, 25, 22, 0.35);
  }
  .figfocus-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 8px 12px;
    border-bottom: 1px solid var(--rule);
    flex: 0 0 auto;
  }
  .figfocus-tools {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .figfocus-tools button,
  .figfocus-tools .figfocus-dl {
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 15px;
    line-height: 38px;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .figfocus-tools button:hover,
  .figfocus-tools .figfocus-dl:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .figfocus-tools button:focus-visible,
  .figfocus-tools .figfocus-dl:focus-visible,
  .figfocus-stage:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .figfocus-zoom {
    min-width: 52px;
    text-align: center;
    color: var(--mute);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  /* The stage: a scroll container; the figure centers while it fits and
     scrolls once it is larger than the stage (margin:auto handles both). */
  .figfocus-stage {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    overflow: auto;
    touch-action: none;
    overscroll-behavior: contain;
    cursor: grab;
    background: #fff;
  }
  .figfocus-stage:active {
    cursor: grabbing;
  }
  .figfocus-img {
    display: block;
    flex: none;
    margin: auto;
    max-width: none;
    user-select: none;
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
  }
  /* The caption, whole: never clamped; scrolls only when very long. */
  .figfocus-caption {
    flex: 0 0 auto;
    margin: 0;
    padding: 10px 16px 12px;
    border-top: 1px solid var(--rule);
    max-height: 32vh;
    overflow: auto;
    color: var(--ink);
    font-size: 14.5px;
    line-height: 1.5;
  }
  .figfocus-caption strong {
    font-weight: 600;
  }
  .figfocus-caption:empty {
    display: none;
  }
  @media (max-width: 640px) {
    .figfocus-bar {
      padding: 6px 8px;
    }
    .figfocus-tools {
      width: 100%;
      gap: 6px;
    }
    .figfocus-tools button,
    .figfocus-tools .figfocus-dl {
      padding: 0 10px;
      font-size: 14px;
    }
    .figfocus-tools [data-act="close"] {
      margin-left: auto;
    }
    .figfocus-caption {
      font-size: 13px;
      padding: 8px 10px 10px;
      max-height: 28vh;
    }
  }
</style>
